# Copy this file to .env and adjust as needed: `cp .env.example .env`
# These values are wired into docker-compose.yml for local development.

# ---- Postgres ----
POSTGRES_USER=my_hours
POSTGRES_PASSWORD=my_hours
POSTGRES_DB=my_hours
# Host port to expose Postgres on (container port is always 5432)
POSTGRES_PORT=5432

# ---- Redis ----
# Host port to expose Redis on (container port is always 6379)
REDIS_PORT=6379

# ---- Backend (Go API) ----
# Port the Go API listens on (inside the container and exposed on the host)
APP_PORT=8080
# Full DSN used by the API to reach Postgres (service name `postgres` on the compose network)
DATABASE_URL=postgres://my_hours:my_hours@postgres:5432/my_hours?sslmode=disable
# Redis address used by the API (service name `redis` on the compose network)
REDIS_ADDR=redis:6379
# Secret used to sign the session cookie. CHANGE THIS in any real deployment.
SESSION_SECRET=change-me-in-production-please-32b
# "dev" relaxes cookie flags (no Secure, SameSite=Lax). Use "production" in prod.
APP_ENV=dev
# Base URL of the web app, used to build password-reset links printed to the log.
APP_URL=http://localhost:5173

# ---- Frontend (Vite dev server) ----
# Host port the Vite dev server is exposed on (this is the URL you open in the browser)
WEB_PORT=5173
